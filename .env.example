# SMTP Configuration for Email Service
# Copy this file to .env.local for local development
# For Vercel deployment, add these as Environment Variables in your Vercel project settings

# SMTP Server Settings
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587

# Your email address (the one you'll send from)
SMTP_USER=your-email@gmail.com

# Your email password or App Password
# For Gmail: Use App Password (generate at https://myaccount.google.com/apppasswords)
SMTP_PASSWORD=your-app-password-here

# Email address to send from (usually same as SMTP_USER)
SMTP_FROM=your-email@gmail.com

# Email address to receive contact form submissions
SMTP_TO=recipient@example.com
